<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": round 1 of the release workflow.
     The GitHub artifact holds x64/, x64-standalone/ and arm64/, each with DeskArcade.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*/DeskArcade.exe" min-matches="1" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
