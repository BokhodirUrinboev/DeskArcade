#, c-sharp-format
msgid "{0} clicks"
msgstr "кликов: {0}"

msgid "the streak starts again with tomorrow's snippet"
msgstr "серия начнётся заново с завтрашнего фрагмента"

msgid "A clean review!"
msgstr "Чистое ревью!"

msgid "Round over"
msgstr "Раунд окончен"

#, c-sharp-format
msgid "{0} of {1} bugs found, {2} at the first click · {3} points in {4}"
msgstr "Найдено багов: {0} из {1}, с первого клика: {2} · очков: {3} · время {4}"

#, c-sharp-format
msgid "{0} of {1} found · {2} points"
msgstr "найдено {0} из {1} · очков: {2}"

#. ---- Spot the Bug: the scoreboard line and the line to share
msgid "Click Start: ten snippets, one bug in each"
msgstr "Нажмите «Старт»: десять фрагментов, в каждом по багу"

#, c-sharp-format
msgid "Snippet {0}/{1} · click the line with the bug"
msgstr "Фрагмент {0}/{1} · нажмите на строку с багом"

