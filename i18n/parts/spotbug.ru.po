msgstr "Мимо · посмотрите исправление и нажмите «Дальше»"

#, c-sharp-format
msgid "Round over · {0}/{1} found · {2} points"
msgstr "Раунд окончен · найдено {0}/{1} · очков: {2}"

#, c-sharp-format
msgid "Daily snippet #{0} · the same for everyone today"
msgstr "Фрагмент дня #{0} · сегодня он у всех один"

msgid "Click the line with the bug · one try a day"
msgstr "Нажмите на строку с багом · одна попытка в день"

msgid "Found it · read the fix"
msgstr "Найден · посмотрите исправление"

msgid "The bug got away · read the fix"
msgstr "Баг ускользнул · посмотрите исправление"

msgid "Daily snippet done · come back tomorrow"
msgstr "Фрагмент дня пройден · возвращайтесь завтра"

#, c-sharp-format
msgid "Daily snippet done · streak {0}"
msgstr "Фрагмент дня пройден · серия {0}"

#, c-sharp-format
msgid "Spot the Bug daily #{0} · found it in {1}, {2} s"
msgstr "Найди баг, фрагмент дня #{0} · найден ({1}, {2} с)"

#, c-sharp-format
msgid "Spot the Bug daily #{0} · the bug got away"
msgstr "Найди баг, фрагмент дня #{0} · баг ускользнул"

#, c-sharp-format
msgid "Spot the Bug · {0}/{1} bugs · {2} points"
msgstr "Найди баг · багов: {0}/{1} · очков: {2}"

