msgid "Your pack: {0} questions. The host sends them to everyone, one at a time."
msgstr "Sizning to'plamingiz: {0} ta savol. Boshlovchi ularni hammaga bittadan yuboradi."

msgid "A pack of your own is a text file: \"Q:\" before each question, then its four answers, \"+\" before the right one and \"-\" before the others."
msgstr "O'z to'plamingiz — matn fayli: har bir savol oldidan «Q:», keyin to'rtta javob, to'g'risi oldidan «+», qolganlari oldidan «-»."

#, c-sharp-format
msgid "{0} questions"
msgstr "{0} ta savol"

