#. ---- Solitaire: FreeCell and Spider
msgid "Klondike"
msgstr "Klondayk"

msgid "FreeCell"
msgstr "Bo'sh katak"

msgid "Spider"
msgstr "O'rgimchak"

msgid "One suit"
msgstr "Bitta mast"

msgid "Two suits"
msgstr "Ikkita mast"

msgid "Four suits"
msgstr "To'rtta mast"

#, c-sharp-format
msgid "Deal #{0}"
msgstr "Tarqatma #{0}"

msgid "Deal number"
msgstr "Tarqatma raqami"

msgid "Click or drag cards to move them · a free cell holds any one card · right-drag moves the felt"
msgstr "Kartalarni bosing yoki suring · bo'sh katakka istalgan bitta karta sig'adi · stolni o'ng tugma bilan suring"

