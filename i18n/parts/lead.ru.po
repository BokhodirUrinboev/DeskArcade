msgstr "Скопировать картинку игры"

msgid "Your year at the desk…"
msgstr "Ваш год за рабочим столом…"

msgid "Show the tour again"
msgstr "Показать знакомство снова"

#, c-sharp-format
msgid "Sudoku daily · {0} ({1}): solved in {2} 🧩"
msgstr "Судоку дня · {0} ({1}): решено за {2} 🧩"

#, c-sharp-format
msgid "Sudoku ({0}): solved in {1} 🧩"
msgstr "Судоку ({0}): решено за {1} 🧩"

#, c-sharp-format
msgid "Minesweeper daily · {0} ({1}): cleared in {2} s 💣"
msgstr "Сапер дня · {0} ({1}): разминировано за {2} с 💣"

#, c-sharp-format
msgid "Minesweeper ({0}): cleared in {1} s 💣"
msgstr "Сапер ({0}): разминировано за {1} с 💣"

