#. ---- the menu
msgid "Coding agents & CI"
msgstr "Агенты для кода и CI"

msgid "No agents, lanes or repos yet"
msgstr "Пока нет агентов, дорожек и репозиториев"

#, c-sharp-format
msgid "Sessions {0} · lanes {1} · repos {2}"
msgstr "Сессии {0} · дорожки {1} · репозитории {2}"

msgid "Alerts when an agent finishes"
msgstr "Оповещать, когда агент закончит"

msgid "Show the overlay when an agent starts working"
msgstr "Показывать игру, когда агент начинает работу"

msgid "Hide the overlay when an agent finishes or needs you"
msgstr "Скрывать игру, когда агент закончил или ждёт вас"

msgid "Pause the game when an agent finishes or needs you"
msgstr "Ставить игру на паузу, когда агент закончил или ждёт вас"

msgid "Show what Claude is doing (two more hooks)"
msgstr "Показывать, что делает Claude (ещё два хука)"

msgid "Copy a config for another agent"
msgstr "Скопировать настройку для другого агента"

msgid "Any other tool (a command line)"
msgstr "Любой другой инструмент (командная строка)"

msgid "Forget finished sessions"
msgstr "Забыть завершённые сессии"

msgid "Clear the status lanes"
msgstr "Очистить дорожки статуса"

msgid "CI and pull requests"
msgstr "CI и пул-реквесты"

msgid "Add a repo folder…"
msgstr "Добавить папку репозитория…"

msgid "Stop following"
msgstr "Перестать отслеживать"

msgid "Read through gh or glab every 2 minutes"
msgstr "Чтение через gh или glab каждые 2 минуты"

msgid "Needs gh or glab, signed in"
msgstr "Нужен gh или glab с выполненным входом"

#. ---- copying a config
#, c-sharp-format
msgid "{0} config copied"
msgstr "Настройка для {0} скопирована"

msgid "Command line"
msgstr "Командная строка"

msgid "merge it into ~/.gemini/settings.json"
msgstr "добавьте её в ~/.gemini/settings.json"

msgid "put it at the top of ~/.codex/config.toml"
msgstr "вставьте её в начало ~/.codex/config.toml"

msgid "save it as ~/.codex/hooks.json, then trust it in /hooks"
msgstr "сохраните как ~/.codex/hooks.json и разрешите в /hooks"

msgid "save it as ~/.cursor/hooks.json, or merge it into the one there"
msgstr "сохраните как ~/.cursor/hooks.json или добавьте в существующий"

msgid "save it as ~/.copilot/hooks/deskarcade.json"
msgstr "сохраните как ~/.copilot/hooks/deskarcade.json"

msgid "save it as ~/.codeium/windsurf/hooks.json, or merge it into the one there"
msgstr "сохраните как ~/.codeium/windsurf/hooks.json или добавьте в существующий"

msgid "add it to .aider.conf.yml in your home or project folder"
msgstr "добавьте её в .aider.conf.yml в домашней папке или папке проекта"

msgid "run these from the tool's own hooks or scripts"
msgstr "запускайте их из хуков инструмента или из скриптов"

msgid "Copy the hook config again"
msgstr "Скопируйте настройку хуков ещё раз"

msgid "it adds two hooks that pass on each step"
msgstr "в ней два новых хука, которые передают каждый шаг"

