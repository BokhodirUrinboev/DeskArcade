#. ---- the menu
msgid "Coding agents & CI"
msgstr "Kod agentlari va CI"

msgid "No agents, lanes or repos yet"
msgstr "Hozircha agent, yo'lak yoki repozitoriy yo'q"

#, c-sharp-format
msgid "Sessions {0} · lanes {1} · repos {2}"
msgstr "Sessiyalar {0} · yo'laklar {1} · repozitoriylar {2}"

msgid "Alerts when an agent finishes"
msgstr "Agent tugatganda ogohlantirish"

msgid "Show the overlay when an agent starts working"
msgstr "Agent ishni boshlaganda o'yinni ko'rsatish"

msgid "Hide the overlay when an agent finishes or needs you"
msgstr "Agent tugatganda yoki sizni kutganda o'yinni yashirish"

msgid "Pause the game when an agent finishes or needs you"
msgstr "Agent tugatganda yoki sizni kutganda o'yinni to'xtatish"

msgid "Show what Claude is doing (two more hooks)"
msgstr "Claude nima qilayotganini ko'rsatish (yana ikkita hook)"

msgid "Copy a config for another agent"
msgstr "Boshqa agent uchun sozlamani nusxalash"

msgid "Any other tool (a command line)"
msgstr "Boshqa vosita (buyruq qatori)"

msgid "Forget finished sessions"
msgstr "Tugagan sessiyalarni unutish"

msgid "Clear the status lanes"
msgstr "Holat yo'laklarini tozalash"

msgid "CI and pull requests"
msgstr "CI va pull requestlar"

msgid "Add a repo folder…"
msgstr "Repozitoriy papkasini qo'shish…"

msgid "Stop following"
msgstr "Kuzatishni to'xtatish"

msgid "Read through gh or glab every 2 minutes"
msgstr "Har 2 daqiqada gh yoki glab orqali o'qiladi"

msgid "Needs gh or glab, signed in"
msgstr "Tizimga kirilgan gh yoki glab kerak"

#. ---- copying a config
#, c-sharp-format
msgid "{0} config copied"
msgstr "{0} sozlamasi nusxalandi"

msgid "Command line"
msgstr "Buyruq qatori"

msgid "merge it into ~/.gemini/settings.json"
msgstr "uni ~/.gemini/settings.json fayliga qo'shing"

msgid "put it at the top of ~/.codex/config.toml"
msgstr "uni ~/.codex/config.toml faylining boshiga qo'ying"

msgid "save it as ~/.codex/hooks.json, then trust it in /hooks"
msgstr "uni ~/.codex/hooks.json sifatida saqlang, so'ng /hooks da ruxsat bering"

msgid "save it as ~/.cursor/hooks.json, or merge it into the one there"
msgstr "uni ~/.cursor/hooks.json sifatida saqlang yoki mavjud faylga qo'shing"

msgid "save it as ~/.copilot/hooks/deskarcade.json"
msgstr "uni ~/.copilot/hooks/deskarcade.json sifatida saqlang"

msgid "save it as ~/.codeium/windsurf/hooks.json, or merge it into the one there"
msgstr "uni ~/.codeium/windsurf/hooks.json sifatida saqlang yoki mavjud faylga qo'shing"

msgid "add it to .aider.conf.yml in your home or project folder"
msgstr "uni uy yoki loyiha papkangizdagi .aider.conf.yml fayliga qo'shing"

msgid "run these from the tool's own hooks or scripts"
msgstr "ularni vositaning o'z hooklari yoki skriptlaridan ishga tushiring"

msgid "Copy the hook config again"
msgstr "Hook sozlamasini qayta nusxalang"

msgid "it adds two hooks that pass on each step"
msgstr "unda har bir qadamni yetkazadigan ikkita hook bor"

