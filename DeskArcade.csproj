<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeskArcade</AssemblyName>
    <RootNamespace>DeskArcade</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Win32/X11 calls are guarded at runtime by OperatingSystem checks. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Single source of truth for the app + installer/package version. Bump it, rebuild the
         installer (Windows) or .deb (Ubuntu), and the new package upgrades any existing install. -->
    <Version>1.8.5</Version>
    <Product>Desk Arcade</Product>
    <Description>Desktop overlay mini-games</Description>
    <Company>Bokhodir Urinboev</Company>
    <Copyright>© 2026 Bokhodir Urinboev</Copyright>
    <ApplicationIcon>assets\DeskArcade.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-Bus client for the XDG GlobalShortcuts portal on Wayland (Platform/Linux/GlobalShortcutsPortal.cs).
         Avalonia already depends on it; referenced explicitly because our code uses it directly. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="assets\DeskArcade.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- the translations, one gettext file per language (see Strings.cs) -->
    <EmbeddedResource Include="i18n\*.po" LogicalName="i18n/%(Filename)%(Extension)" />
    <EmbeddedResource Include="i18n\parts\*.po" LogicalName="i18n/parts/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spot the Bug's snippets, one JSON file per batch (see Games/SpotBugDeck.cs) -->
    <EmbeddedResource Include="spotbug\*.json" LogicalName="spotbug/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- the unit tests are their own project -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
