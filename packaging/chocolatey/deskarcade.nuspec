<?xml version="1.0" encoding="utf-8"?>
<!--
  Chocolatey package for Desk Arcade, stamped for a release by packaging/chocolatey/Update-ChocolateyPackage.ps1
  (the version here and in tools/chocolateyinstall.ps1 is the release last stamped into it). After each release,
  .github/workflows/packages.yml packs it and pushes it to the community repository: see docs/RELEASING.md.
  The package downloads the release's Setup .exe; nothing is embedded, so it needs no VERIFICATION.txt.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>deskarcade</id>
    <version>1.8.5</version>
    <packageSourceUrl>https://github.com/BokhodirUrinboev/DeskArcade/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>BokhodirUrinboev</owners>
    <title>Desk Arcade</title>
    <authors>Bokhodir Urinboev</authors>
    <projectUrl>https://github.com/BokhodirUrinboev/DeskArcade</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/BokhodirUrinboev/DeskArcade@main/assets/DeskArcade.png</iconUrl>
